.kotlin
build

# ignore pasted fonts inside :core module - but keep minecraft font as a default one
/core/src/main/resources/fonts/*
!/core/src/main/resources/fonts/minecraft
!/core/src/main/resources/fonts/generated-fonts.txt

# ignore full precompiled fonts folder
/precompiled_fonts/*
!/precompiled_fonts/.gitkeep
